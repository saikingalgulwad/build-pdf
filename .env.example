# Local Postgres example (replace with your real connection string)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/build_pdf?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"

# Local app URL (production: your deployed domain, e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
